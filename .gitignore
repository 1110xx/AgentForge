.pytest_cache/
.ruff_cache/
pycache
*.py[cod]
.venv/
frontend/node_modules/
frontend/examples/*/node_modules/
frontend/packages/+/dist/
frontend/**/*.tsbuildinfo
dist/

# Local tool binaries (kind/helm) pulled for the L3 Kind gate
.tools/

# User config — contains API keys, must never be committed
config.toml
backend/config.toml
.env
*.env.local
*.env.production

# OCR-reconstruction debris: corrupted backups kept for reference
contracts/_ocr-corrupted-backup/

# Byte-compiled / temp
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
# Local default store (SDD Phase 3.5-B): run.py creates a durable SQLite file
# when no AGENT_PLATFORM_DATABASE_URL is configured.
backend/agent-platform.db
*.db

# Windows NUL redirect artifact (must never be committed)
nul

# Dev-run logs / live-verify artifacts written to the tree by ad-hoc runs
backend/_run-api.log
backend/_run-api.json
scripts/.verify-live-*.log
scripts/.verify-live-*.json
