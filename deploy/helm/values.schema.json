{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "images",
    "controlPlane",
    "dependencies",
    "secrets",
    "integration",
    "sandbox",
    "autoscaling"
  ],
  "properties": {
    "images": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "controlPlane",
        "runtime"
      ],
      "properties": {
        "controlPlane": {
          "$ref": "#/$defs/image"
        },
        "runtime": {
          "$ref": "#/$defs/image"
        },
        "frontend": {
          "$ref": "#/$defs/image"
        }
      }
    },
    "controlPlane": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "replicas",
        "apiPort",
        "kubernetesApiCidr",
        "dependencyEgressCidr"
      ],
      "properties": {
        "replicas": {
          "default": 3
        },
        "apiPort": {
          "const": 8080
        },
        "kubernetesApiCidr": {
          "type": "string",
          "pattern": "^[0-9./:a-fA-F]+$"
        },
        "dependencyEgressCidr": {
          "type": "string",
          "pattern": "^[0-9./:a-fA-F]+$"
        },
        "workersReplicas": {
          "type": "integer",
          "minimum": 0,
          "default": 2
        },
        "apiResources": {
          "$ref": "#/$defs/resources"
        },
        "workerResources": {
          "$ref": "#/$defs/resources"
        },
        "migrationResources": {
          "$ref": "#/$defs/resources"
        },
        "apiProbes": {
          "$ref": "#/$defs/probes"
        },
        "workerProbes": {
          "$ref": "#/$defs/probes"
        }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "className",
        "host"
      ],
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "className": {
          "type": "string",
          "default": "nginx"
        },
        "host": {
          "type": "string",
          "minLength": 1
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {}
        },
        "tls": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "secretName": {
              "type": "string",
              "minLength": 1
            },
            "clusterIssuer": {
              "type": "string"
            }
          }
        }
      }
    },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "localScratch": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "storageClassName": {
              "type": "string",
              "default": ""
            },
            "size": {
              "type": "string",
              "pattern": "^[0-9]+([EPTGMK]i?)?$"
            }
          }
        }
      }
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "postgresql",
        "nats",
        "s3",
        "oidc"
      ],
      "properties": {
        "postgresql": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "endpoint"
          ],
          "properties": {
            "endpoint": {
              "type": "string",
              "pattern": "^postgresql\\+asyncpg://"
            }
          }
        },
        "nats": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "endpoint",
            "monitoringEndpoint",
            "stream",
            "streamReplicas"
          ],
          "properties": {
            "endpoint": {
              "type": "string",
              "pattern": "^(nats|tls)://"
            },
            "monitoringEndpoint": {
              "type": "string",
              "pattern": "^https?://"
            },
            "stream": {
              "type": "string",
              "minLength": 1
            },
            "streamReplicas": {
              "const": 3
            }
          }
        },
        "s3": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "endpoint",
            "bucket"
          ],
          "properties": {
            "endpoint": {
              "type": "string",
              "pattern": "^https?://"
            },
            "bucket": {
              "type": "string",
              "minLength": 3
            }
          }
        },
        "oidc": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "issuer"
          ],
          "properties": {
            "issuer": {
              "type": "string",
              "pattern": "^https?://"
            }
          }
        }
      }
    },
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "externalSecretName",
        "storeRefName",
        "storeRefKind",
        "remoteKey"
      ],
      "properties": {
        "externalSecretName": {
          "type": "string",
          "minLength": 1
        },
        "storeRefName": {
          "type": "string",
          "minLength": 1
        },
        "storeRefKind": {
          "enum": [
            "SecretStore",
            "ClusterSecretStore"
          ]
        },
        "remoteKey": {
          "type": "string",
          "minLength": 1
        },
        "externalSecretContract": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "integration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "containerFactory",
        "workerFactory"
      ],
      "properties": {
        "containerFactory": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_.]*:[A-Za-z_][A-Za-z0-9_]*$"
        },
        "workerFactory": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_.]*:[A-Za-z_][A-Za-z0-9_]*$"
        }
      }
    },
    "sandbox": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "namespace",
        "serviceAccountName",
        "runtimeClassName",
        "maxActiveAttempts"
      ],
      "properties": {
        "namespace": {
          "const": "agent-platform-sandbox"
        },
        "serviceAccountName": {
          "const": "agent-platform-sandbox"
        },
        "runtimeClassName": {
          "type": "string"
        },
        "maxActiveAttempts": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "autoscaling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minReplicas",
        "maxReplicas",
        "pendingMessagesPerReplica"
      ],
      "properties": {
        "minReplicas": {
          "default": 2
        },
        "maxReplicas": {
          "default": 20
        },
        "pendingMessagesPerReplica": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "apiCpuAverageUtilization": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 70
        },
        "enabled": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "frontend": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "replicas",
        "resources",
        "probes",
        "nginx"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "replicas": {
          "type": "integer",
          "minimum": 1
        },
        "resources": {
          "$ref": "#/$defs/resources"
        },
        "probes": {
          "$ref": "#/$defs/probes"
        },
        "nginx": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "staticRoot",
            "apiServiceName",
            "apiPort",
            "proxyReadTimeoutSeconds"
          ],
          "properties": {
            "staticRoot": {
              "type": "string",
              "minLength": 1
            },
            "apiServiceName": {
              "type": "string",
              "minLength": 1
            },
            "apiPort": {
              "type": "integer",
              "minimum": 1
            },
            "proxyReadTimeoutSeconds": {
              "type": "integer",
              "minimum": 30
            }
          }
        }
      }
    }
  },
  "$defs": {
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requests": {
          "$ref": "#/$defs/quantityPair"
        },
        "limits": {
          "$ref": "#/$defs/quantityPair"
        }
      }
    },
    "quantityPair": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cpu": {
          "type": "string"
        },
        "memory": {
          "type": "string"
        }
      }
    },
    "probes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "readiness": {
          "$ref": "#/$defs/probe"
        },
        "liveness": {
          "$ref": "#/$defs/probe"
        }
      }
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "initialDelaySeconds",
        "periodSeconds",
        "timeoutSeconds",
        "failureThreshold"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "command": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "initialDelaySeconds": {
          "type": "integer",
          "minimum": 0
        },
        "periodSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "failureThreshold": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "digest"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    }
  }
}
