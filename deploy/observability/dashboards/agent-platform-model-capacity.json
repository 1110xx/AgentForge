  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Model calls by outcome (per model)",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [
        {"refId": "A", "expr": "sum by (model_id) (rate(agent_platform_model_calls_total{outcome=\"ok\"}[5m]))", "legendFormat": "{{model_id}} ok"},
        {"refId": "B", "expr": "sum by (model_id) (rate(agent_platform_model_calls_total{outcome=\"error\"}[5m]))", "legendFormat": "{{model_id}} error"}
      ],
      "options": {"tooltip": {"mode": "multi"}, "legend": {"displayMode": "list", "placement": "bottom"}},
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}}, "overrides": []}
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Model latency p50/p95/p99",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [
        {"refId": "A", "expr": "histogram_quantile(0.50, sum by (le) (rate(agent_platform_model_latency_seconds_bucket[5m])))", "legendFormat": "p50"},
        {"refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(agent_platform_model_latency_seconds_bucket[5m])))", "legendFormat": "p95"},
        {"refId": "C", "expr": "histogram_quantile(0.99, sum by (le) (rate(agent_platform_model_latency_seconds_bucket[5m])))", "legendFormat": "p99"}
      ],
      "options": {"tooltip": {"mode": "multi"}, "legend": {"displayMode": "list", "placement": "bottom"}},
      "fieldConfig": {"defaults": {"unit": "s", "color": {"mode": "palette-classic"}}, "overrides": []}
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Queue → running latency p95",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 8},
      "targets": [
        {"refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(agent_platform_queue_latency_seconds_bucket[5m])))", "legendFormat": "p95"}
      ],
      "options": {"colorMode": "value", "graphMode": "none", "justifyMode": "auto", "reduceOptions": {"calcs": ["lastNotNull"]}},
      "fieldConfig": {"defaults": {"unit": "s", "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 30}, {"color": "red", "value": 120}]}}, "overrides": []}
    },
    {
      "id": 4,
      "type": "stat",
