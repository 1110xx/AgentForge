# DeepSeek API Configuration
# Copy this file to .env and set your actual API key
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# Alternative API key names (tried in order if DEEPSEEK_API_KEY is not set)
# OPENAI_API_KEY=your-openai-api-key-here
# ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Platform Configuration
AGENT_PLATFORM_DATABASE_URL=postgresql+asyncpg://agent_platform:agent_platform@localhost:5432/agent_platform
AGENT_PLATFORM_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
AGENT_PLATFORM_DEFAULT_MODEL=deepseek-chat

# Optional: Demo mode (no API key required)
# AGENT_PLATFORM_USE_DEMO_MODE=true