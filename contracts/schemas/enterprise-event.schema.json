{
  "$defs": {
    "ActionProposalPayload": {
      "additionalProperties": false,
      "properties": {
        "action_ref": {
          "title": "Action Ref",
          "type": "string"
        },
        "attempt_id": {
          "title": "Attempt Id",
          "type": "string"
        },
        "kind": {
          "const": "action.proposal",
          "title": "Kind",
          "type": "string"
        },
        "proposal_state": {
          "title": "Proposal State",
          "type": "string"
        },
        "risk_class": {
          "title": "Risk Class",
          "type": "string"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "action_ref",
        "run_id",
        "attempt_id",
        "proposal_state",
        "risk_class"
      ],
      "title": "ActionProposalPayload",
      "type": "object"
    },
    "AgentTurnCompletedPayload": {
      "additionalProperties": false,
      "description": "Persistent bridge event: full-turn aggregation (SDD ¡ì11.4).\n\nCarries the complete aggregated thinking, the complete assistant message\ntext and the tool-call summary for one turn. Replay-safe: a freshly\nopened or reconnected frontend renders the turn from this single event\ninstead of thousands of ephemeral stream-chunks.",
      "properties": {
        "kind": {
          "const": "agent.turn.completed",
          "title": "Kind",
          "type": "string"
        },
        "message_text": {
          "default": "",
          "title": "Message Text",
          "type": "string"
        },
        "thinking": {
          "default": "",
          "title": "Thinking",
          "type": "string"
        },
        "tool_calls": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ToolCallSummary"
          },
          "title": "Tool Calls",
          "type": "array"
        },
        "turn_seq": {
          "minimum": 1,
          "title": "Turn Seq",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "turn_seq"
      ],
      "title": "AgentTurnCompletedPayload",
      "type": "object"
    },
    "ApprovalDecidedPayload": {
      "additionalProperties": false,
      "properties": {
        "approval_id": {
          "title": "Approval Id",
          "type": "string"
        },
        "kind": {
          "const": "approval.decided",
          "title": "Kind",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/ApprovalState"
        }
      },
      "required": [
        "kind",
        "approval_id",
        "status"
      ],
      "title": "ApprovalDecidedPayload",
      "type": "object"
    },
    "ApprovalState": {
      "enum": [
        "PENDING",
        "APPROVED",
        "REJECTED",
        "EXPIRED",
        "CANCELLED"
      ],
      "title": "ApprovalState",
      "type": "string"
    },
    "ArtifactVersionPayload": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "title": "Artifact Id",
          "type": "string"
        },
        "classification": {
          "title": "Classification",
          "type": "string"
        },
        "kind": {
          "const": "artifact.version",
          "title": "Kind",
          "type": "string"
        },
        "logical_name": {
          "title": "Logical Name",
          "type": "string"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "state": {
          "title": "State",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "artifact_id",
        "run_id",
        "logical_name",
        "classification",
        "version",
        "state"
      ],
      "title": "ArtifactVersionPayload",
      "type": "object"
    },
    "AttemptLifecyclePayload": {
      "additionalProperties": false,
      "properties": {
        "attempt_id": {
          "title": "Attempt Id",
          "type": "string"
        },
        "kind": {
          "const": "attempt.lifecycle",
          "title": "Kind",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/AttemptState"
        }
      },
      "required": [
        "kind",
        "attempt_id",
        "status"
      ],
      "title": "AttemptLifecyclePayload",
      "type": "object"
    },
    "AttemptState": {
      "enum": [
        "CREATED",
        "PROVISIONING",
        "CLAIMED",
        "RUNNING",
        "CHECKPOINTING",
        "CHECKPOINTED_FOR_APPROVAL",
        "SUCCEEDED",
        "FAILED",
        "LOST",
        "CANCELLED"
      ],
      "title": "AttemptState",
      "type": "string"
    },
    "EffectState": {
      "enum": [
        "PREPARED",
        "EXECUTING",
        "UNKNOWN",
        "SUCCEEDED",
        "FAILED"
      ],
      "title": "EffectState",
      "type": "string"
    },
    "EffectStatusChangedPayload": {
      "additionalProperties": false,
      "properties": {
        "effect_id": {
          "title": "Effect Id",
          "type": "string"
        },
        "kind": {
          "const": "effect.status.changed",
          "title": "Kind",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/EffectState"
        }
      },
      "required": [
        "kind",
        "effect_id",
        "status"
      ],
      "title": "EffectStatusChangedPayload",
      "type": "object"
    },
    "EventType": {
      "enum": [
        "run.created",
        "run.status.changed",
        "attempt.lifecycle",
        "tool.invocation.recorded",
        "approval.decided",
        "effect.status.changed",
        "ui.surface.committed",
        "artifact.version",
        "action.proposal",
        "tool.execution.started",
        "tool.execution.ended",
        "agent.turn.completed"
      ],
      "title": "EventType",
      "type": "string"
    },
    "JsonValue": {},
    "RunCreatedPayload": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "run.created",
          "title": "Kind",
          "type": "string"
        },
        "workflow_type": {
          "title": "Workflow Type",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "workflow_type"
      ],
      "title": "RunCreatedPayload",
      "type": "object"
    },
    "RunState": {
      "enum": [
        "QUEUED",
        "RUNNING",
        "WAITING_APPROVAL",
        "RECOVERING",
        "CANCEL_REQUESTED",
        "NEEDS_ATTENTION",
        "SUCCEEDED",
        "FAILED",
        "CANCELLED"
      ],
      "title": "RunState",
      "type": "string"
    },
    "RunStatusChangedPayload": {
      "additionalProperties": false,
      "properties": {
        "current": {
          "$ref": "#/$defs/RunState"
        },
        "kind": {
          "const": "run.status.changed",
          "title": "Kind",
          "type": "string"
        },
        "previous": {
          "$ref": "#/$defs/RunState"
        }
      },
      "required": [
        "kind",
        "previous",
        "current"
      ],
      "title": "RunStatusChangedPayload",
      "type": "object"
    },
    "ToolCallSummary": {
      "additionalProperties": false,
      "description": "One aggregated tool call inside an ``agent.turn.completed`` payload.",
      "properties": {
        "call_id": {
          "title": "Call Id",
          "type": "string"
        },
        "is_error": {
          "default": false,
          "title": "Is Error",
          "type": "boolean"
        },
        "status": {
          "enum": [
            "succeeded",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        },
        "tool_name": {
          "title": "Tool Name",
          "type": "string"
        }
      },
      "required": [
        "call_id",
        "tool_name",
        "status"
      ],
      "title": "ToolCallSummary",
      "type": "object"
    },
    "ToolExecutionEndedPayload": {
      "additionalProperties": false,
      "description": "Persistent bridge event: pi-agent-core ToolExecutionEndEvent.",
      "properties": {
        "call_id": {
          "title": "Call Id",
          "type": "string"
        },
        "is_error": {
          "default": false,
          "title": "Is Error",
          "type": "boolean"
        },
        "kind": {
          "const": "tool.execution.ended",
          "title": "Kind",
          "type": "string"
        },
        "result": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/JsonValue"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Result"
        },
        "status": {
          "enum": [
            "succeeded",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        },
        "tool_name": {
          "title": "Tool Name",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "call_id",
        "tool_name",
        "status"
      ],
      "title": "ToolExecutionEndedPayload",
      "type": "object"
    },
    "ToolExecutionStartedPayload": {
      "additionalProperties": false,
      "description": "Persistent bridge event: pi-agent-core ToolExecutionStartEvent.\n\nDurable (append_event -> PG -> Outbox -> SSE) so a reconnecting frontend\ncan render the tool activity from the event log alone. ``args`` is the\nbounded, redacted-at-source argument snapshot; never raw credentials.",
      "properties": {
        "args": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/JsonValue"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Args"
        },
        "call_id": {
          "title": "Call Id",
          "type": "string"
        },
        "kind": {
          "const": "tool.execution.started",
          "title": "Kind",
          "type": "string"
        },
        "tool_name": {
          "title": "Tool Name",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "call_id",
        "tool_name"
      ],
      "title": "ToolExecutionStartedPayload",
      "type": "object"
    },
    "ToolInvocationRecordedPayload": {
      "additionalProperties": false,
      "properties": {
        "call_id": {
          "title": "Call Id",
          "type": "string"
        },
        "kind": {
          "const": "tool.invocation.recorded",
          "title": "Kind",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/ToolInvocationState"
        }
      },
      "required": [
        "kind",
        "call_id",
        "status"
      ],
      "title": "ToolInvocationRecordedPayload",
      "type": "object"
    },
    "ToolInvocationState": {
      "enum": [
        "CREATED",
        "AUTHORIZED",
        "EXECUTING",
        "UNKNOWN",
        "SUCCEEDED",
        "FAILED",
        "REJECTED",
        "CANCELLED"
      ],
      "title": "ToolInvocationState",
      "type": "string"
    },
    "UiSurfaceCommittedPayload": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "ui.surface.committed",
          "title": "Kind",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "surface_id": {
          "title": "Surface Id",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "surface_id",
        "revision"
      ],
      "title": "UiSurfaceCommittedPayload",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "attempt_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Attempt Id"
    },
    "causation_event_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Causation Event Id"
    },
    "event_id": {
      "title": "Event Id",
      "type": "string"
    },
    "event_seq": {
      "minimum": 1,
      "title": "Event Seq",
      "type": "integer"
    },
    "event_type": {
      "$ref": "#/$defs/EventType"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "payload": {
      "discriminator": {
        "mapping": {
          "action.proposal": "#/$defs/ActionProposalPayload",
          "agent.turn.completed": "#/$defs/AgentTurnCompletedPayload",
          "approval.decided": "#/$defs/ApprovalDecidedPayload",
          "artifact.version": "#/$defs/ArtifactVersionPayload",
          "attempt.lifecycle": "#/$defs/AttemptLifecyclePayload",
          "effect.status.changed": "#/$defs/EffectStatusChangedPayload",
          "run.created": "#/$defs/RunCreatedPayload",
          "run.status.changed": "#/$defs/RunStatusChangedPayload",
          "tool.execution.ended": "#/$defs/ToolExecutionEndedPayload",
          "tool.execution.started": "#/$defs/ToolExecutionStartedPayload",
          "tool.invocation.recorded": "#/$defs/ToolInvocationRecordedPayload",
          "ui.surface.committed": "#/$defs/UiSurfaceCommittedPayload"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/RunCreatedPayload"
        },
        {
          "$ref": "#/$defs/RunStatusChangedPayload"
        },
        {
          "$ref": "#/$defs/AttemptLifecyclePayload"
        },
        {
          "$ref": "#/$defs/ToolInvocationRecordedPayload"
        },
        {
          "$ref": "#/$defs/ApprovalDecidedPayload"
        },
        {
          "$ref": "#/$defs/EffectStatusChangedPayload"
        },
        {
          "$ref": "#/$defs/UiSurfaceCommittedPayload"
        },
        {
          "$ref": "#/$defs/ArtifactVersionPayload"
        },
        {
          "$ref": "#/$defs/ActionProposalPayload"
        },
        {
          "$ref": "#/$defs/ToolExecutionStartedPayload"
        },
        {
          "$ref": "#/$defs/ToolExecutionEndedPayload"
        },
        {
          "$ref": "#/$defs/AgentTurnCompletedPayload"
        }
      ],
      "title": "Payload"
    },
    "payload_schema": {
      "title": "Payload Schema",
      "type": "string"
    },
    "producer_service": {
      "title": "Producer Service",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "enterprise-event/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "tenant_id": {
      "title": "Tenant Id",
      "type": "string"
    },
    "trace_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Trace Id"
    }
  },
  "required": [
    "schema_version",
    "event_id",
    "tenant_id",
    "run_id",
    "event_seq",
    "event_type",
    "occurred_at",
    "producer_service",
    "payload_schema",
    "payload"
  ],
  "title": "EnterpriseEventEnvelope",
  "type": "object"
}
