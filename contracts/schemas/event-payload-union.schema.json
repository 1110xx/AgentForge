{
  "$defs": {
    "ActionProposalPayload": {
      "additionalProperties": false,
      "properties": {
        "action_ref": {
          "title": "Action Ref",
          "type": "string"
        },
        "attempt_id": {
          "title": "Attempt Id",
          "type": "string"
        },
        "kind": {
          "const": "action.proposal",
          "title": "Kind",
          "type": "string"
        },
        "proposal_state": {
          "title": "Proposal State",
          "type": "string"
        },
        "risk_class": {
          "title": "Risk Class",
          "type": "string"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "action_ref",
        "run_id",
        "attempt_id",
        "proposal_state",
        "risk_class"
      ],
      "title": "ActionProposalPayload",
      "type": "object"
    },
    "ApprovalDecidedPayload": {
      "additionalProperties": false,
      "properties": {
        "approval_id": {
          "title": "Approval Id",
          "type": "string"
        },
        "kind": {
          "const": "approval.decided",
          "title": "Kind",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/ApprovalState"
        }
      },
      "required": [
        "kind",
        "approval_id",
        "status"
      ],
      "title": "ApprovalDecidedPayload",
      "type": "object"
    },
    "ApprovalState": {
      "enum": [
        "PENDING",
        "APPROVED",
        "REJECTED",
        "EXPIRED",
        "CANCELLED"
      ],
      "title": "ApprovalState",
      "type": "string"
    },
    "ArtifactVersionPayload": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "title": "Artifact Id",
          "type": "string"
        },
        "classification": {
          "title": "Classification",
          "type": "string"
        },
        "kind": {
          "const": "artifact.version",
          "title": "Kind",
          "type": "string"
        },
        "logical_name": {
          "title": "Logical Name",
          "type": "string"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "state": {
          "title": "State",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "artifact_id",
        "run_id",
        "logical_name",
        "classification",
        "version",
        "state"
      ],
      "title": "ArtifactVersionPayload",
      "type": "object"
    },
    "AttemptLifecyclePayload": {
      "additionalProperties": false,
      "properties": {
        "attempt_id": {
          "title": "Attempt Id",
          "type": "string"
        },
        "kind": {
          "const": "attempt.lifecycle",
          "title": "Kind",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/AttemptState"
        }
      },
      "required": [
        "kind",
        "attempt_id",
        "status"
      ],
      "title": "AttemptLifecyclePayload",
      "type": "object"
    },
    "AttemptState": {
      "enum": [
        "CREATED",
        "PROVISIONING",
        "CLAIMED",
        "RUNNING",
        "CHECKPOINTING",
        "CHECKPOINTED_FOR_APPROVAL",
        "SUCCEEDED",
        "FAILED",
        "LOST",
        "CANCELLED"
      ],
      "title": "AttemptState",
      "type": "string"
    },
    "EffectState": {
      "enum": [
        "PREPARED",
        "EXECUTING",
        "UNKNOWN",
        "SUCCEEDED",
        "FAILED"
      ],
      "title": "EffectState",
      "type": "string"
    },
    "EffectStatusChangedPayload": {
      "additionalProperties": false,
      "properties": {
        "effect_id": {
          "title": "Effect Id",
          "type": "string"
        },
        "kind": {
          "const": "effect.status.changed",
          "title": "Kind",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/EffectState"
        }
      },
      "required": [
        "kind",
        "effect_id",
        "status"
      ],
      "title": "EffectStatusChangedPayload",
      "type": "object"
    },
    "RunCreatedPayload": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "run.created",
          "title": "Kind",
          "type": "string"
        },
        "workflow_type": {
          "title": "Workflow Type",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "workflow_type"
      ],
      "title": "RunCreatedPayload",
      "type": "object"
    },
    "RunState": {
      "enum": [
        "QUEUED",
        "RUNNING",
        "WAITING_APPROVAL",
        "RECOVERING",
        "CANCEL_REQUESTED",
        "NEEDS_ATTENTION",
        "SUCCEEDED",
        "FAILED",
        "CANCELLED"
      ],
      "title": "RunState",
      "type": "string"
    },
    "RunStatusChangedPayload": {
      "additionalProperties": false,
      "properties": {
        "current": {
          "$ref": "#/$defs/RunState"
        },
        "kind": {
          "const": "run.status.changed",
          "title": "Kind",
          "type": "string"
        },
        "previous": {
          "$ref": "#/$defs/RunState"
        }
      },
      "required": [
        "kind",
        "previous",
        "current"
      ],
      "title": "RunStatusChangedPayload",
      "type": "object"
    },
    "ToolInvocationRecordedPayload": {
      "additionalProperties": false,
      "properties": {
        "call_id": {
          "title": "Call Id",
          "type": "string"
        },
        "kind": {
          "const": "tool.invocation.recorded",
          "title": "Kind",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/ToolInvocationState"
        }
      },
      "required": [
        "kind",
        "call_id",
        "status"
      ],
      "title": "ToolInvocationRecordedPayload",
      "type": "object"
    },
    "ToolInvocationState": {
      "enum": [
        "CREATED",
        "AUTHORIZED",
        "EXECUTING",
        "UNKNOWN",
        "SUCCEEDED",
        "FAILED",
        "REJECTED",
        "CANCELLED"
      ],
      "title": "ToolInvocationState",
      "type": "string"
    },
    "UiSurfaceCommittedPayload": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "ui.surface.committed",
          "title": "Kind",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "surface_id": {
          "title": "Surface Id",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "surface_id",
        "revision"
      ],
      "title": "UiSurfaceCommittedPayload",
      "type": "object"
    }
  },
  "discriminator": {
    "mapping": {
      "action.proposal": "#/$defs/ActionProposalPayload",
      "approval.decided": "#/$defs/ApprovalDecidedPayload",
      "artifact.version": "#/$defs/ArtifactVersionPayload",
      "attempt.lifecycle": "#/$defs/AttemptLifecyclePayload",
      "effect.status.changed": "#/$defs/EffectStatusChangedPayload",
      "run.created": "#/$defs/RunCreatedPayload",
      "run.status.changed": "#/$defs/RunStatusChangedPayload",
      "tool.invocation.recorded": "#/$defs/ToolInvocationRecordedPayload",
      "ui.surface.committed": "#/$defs/UiSurfaceCommittedPayload"
    },
    "propertyName": "kind"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/RunCreatedPayload"
    },
    {
      "$ref": "#/$defs/RunStatusChangedPayload"
    },
    {
      "$ref": "#/$defs/AttemptLifecyclePayload"
    },
    {
      "$ref": "#/$defs/ToolInvocationRecordedPayload"
    },
    {
      "$ref": "#/$defs/ApprovalDecidedPayload"
    },
    {
      "$ref": "#/$defs/EffectStatusChangedPayload"
    },
    {
      "$ref": "#/$defs/UiSurfaceCommittedPayload"
    },
    {
      "$ref": "#/$defs/ArtifactVersionPayload"
    },
    {
      "$ref": "#/$defs/ActionProposalPayload"
    }
  ]
}
